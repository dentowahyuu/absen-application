{
  "name": "absen-local",
  "private": true,
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:ai": "cd apps/ai-engine && venv\\Scripts\\uvicorn.exe main:app --reload --port 8000",
    "dev": "concurrently -n \"WEB,AI\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:ai\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
