# =====================================================================
# This file is used in TWO different ways depending on how you run the
# app -- read the section that matches your setup.
#
# 1) `docker compose up -d` (recommended for the VM / production):
#    Only the "Docker Compose orchestration" variables below are read
#    (by docker-compose.yml, to configure the containers). The app's
#    own connection URLs (DATABASE_URL, MINIO_ENDPOINT, AI_ENGINE_URL)
#    are hardcoded in docker-compose.yml to use the Docker service
#    names (postgres/minio/ai-engine), NOT this file -- containers on
#    the same compose network can't reach each other via "localhost".
#
# 2) Running each service natively (`npm run dev`, no Docker) -- e.g.
#    local Windows development:
#    Copy the "App runtime (native/local dev only)" variables into
#    apps/web/.env.local, pointing at wherever your local Postgres/
#    MinIO/AI engine actually run (often localhost, but not always --
#    see this project's own dev history for an example where Postgres
#    ran on a non-default port).
# =====================================================================

# --- Docker Compose orchestration (read by docker-compose.yml) ---
POSTGRES_USER=absen
POSTGRES_PASSWORD=absen
POSTGRES_DB=absen_db
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Minimum cosine similarity to accept a face match (0-1).
# InsightFace/ArcFace cosine similarity for the SAME person across different
# captures typically lands around 0.4-0.7 (not near 1.0), while different
# people usually score near 0. 0.5 is a safe default with a wide margin --
# tune per your own test data if needed.
FACE_MATCH_THRESHOLD=0.5

# Random secret used to sign admin session tokens. Generate a NEW one for
# production (don't reuse a value from local dev), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- App runtime (native/local dev only -- copy into apps/web/.env.local) ---
# DATABASE_URL=postgresql://absen:absen@localhost:5432/absen_db
# MINIO_ENDPOINT=localhost
# MINIO_PORT_INTERNAL=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_EVIDENCE=attendance-evidence
# MINIO_BUCKET_PROFILES=employee-profiles
# AI_ENGINE_URL=http://localhost:8000
